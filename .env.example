# PostgreSQL connection for lead capture, newsletter and chat logs.
# Local example (Homebrew postgresql@17):
# DATABASE_URL=postgres://savo:savo@localhost:5432/savotech
# When unset (or unreachable) the app falls back to a local JSON store in .data/
# so the homepage preview never breaks.
DATABASE_URL=

# Canonical production URL (used for SEO metadata, sitemap and JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.savotechnologies.com

# Must match the basePath in next.config.ts (empty when serving from domain root).
NEXT_PUBLIC_BASE_PATH=/savotech
