{
  "name": "savotech-website",
  "version": "1.0.0",
  "private": true,
  "description": "Savo Technologies \u2014 corporate homepage. Next.js + PostgreSQL.",
  "scripts": {
    "dev": "node api.js && next dev -p 3000",
    "build": "node api.js && next build",
    "start": "node api.js && next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^16.3.4",
    "pg": "^8.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
